{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Link",
          "value": "</.well-known/api-catalog>; rel=\"api-catalog\", </docs/api>; rel=\"service-doc\", </openapi.json>; rel=\"service-desc\", </.well-known/oauth-authorization-server>; rel=\"oauth-authorization-server\", </.well-known/oauth-protected-resource>; rel=\"oauth-protected-resource\", </.well-known/mcp/server-card.json>; rel=\"mcp-server-card\", </.well-known/agent-skills/index.json>; rel=\"agent-skills\", </.well-known/ai-catalog.json>; rel=\"ai-catalog\""
        }
      ]
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*text/markdown.*)"
        }
      ],
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "x-markdown-tokens",
          "value": "380"
        }
      ]
    },
    {
      "source": "/index.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "x-markdown-tokens",
          "value": "380"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/.well-known/api-catalog",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/linkset+json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/.well-known/ai-catalog.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/.well-known/openid-configuration",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/.well-known/mcp/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/mcp-server-card+json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/.well-known/agent-skills/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/auth.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/api/health",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/nb/blog/forsta-bivirkninger-av-medisiner",
      "destination": "/no/blog/forsta-medisinbivirkninger",
      "statusCode": 301
    },
    {
      "source": "/nb/blog/forsta-diabetes-og-hba1c-nivaer",
      "destination": "/no/blog/forsta-diabetes-og-hba1c",
      "statusCode": 301
    },
    {
      "source": "/nb/blog/forsta-kolesterol-og-lipidpanel",
      "destination": "/no/blog/forsta-kolesterol-og-lipidprofil",
      "statusCode": 301
    },
    {
      "source": "/nb/blog/handtere-hoyt-blodtrykk",
      "destination": "/no/blog/handtering-av-hoyt-blodtrykk",
      "statusCode": 301
    },
    {
      "source": "/nb/blog/hvordan-forsta-blodprovesvar",
      "destination": "/no/blog/hvordan-lese-blodproevesvar",
      "statusCode": 301
    },
    {
      "source": "/nb/blog",
      "destination": "/no/blog",
      "statusCode": 301
    },
    {
      "source": "/nb/blog/:slug",
      "destination": "/no/blog/:slug",
      "statusCode": 301
    },
    {
      "source": "/download",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(iPad|iPhone|iPod|Macintosh|Mac OS|ipad|iphone|ipod|macintosh|mac os).*"
        }
      ],
      "destination": "https://apps.apple.com/app/id6837951020?pt=128779508&ct=friends_family_share&mt=8",
      "statusCode": 302
    },
    {
      "source": "/download",
      "destination": "https://play.google.com/store/apps/details?id=com.medgptai.app&referrer=utm_source%3Dfriends_family%26utm_medium%3Dsocial_share%26utm_campaign%3Dresult_share",
      "statusCode": 302
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*text/markdown.*)"
        }
      ],
      "destination": "/index.md"
    },
    {
      "source": "/api/health",
      "destination": "/api/health.json"
    },
    {
      "source": "/download",
      "destination": "/api/download"
    }
  ]
}
