---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { getCollection, render } from 'astro:content';
import { slugMap } from '../../utils/slugMap';
import { extractFaqsFromMarkdown } from '../../utils/faqExtractor';

const siteUrl = 'https://medgptai.droploop.in';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const enPosts = posts.filter(post => post.id.startsWith('en/'));
  return enPosts.map((post) => ({
    params: { slug: post.id.replace('en/', '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const enSlug = post.id.replace('en/', '');
const faqs = extractFaqsFromMarkdown(post.body);

// Build hreflang alternates from the slug map
const hreflangAlternates: Array<{ lang: string; href: string }> = [];
const slugTranslations = slugMap[enSlug];
if (slugTranslations) {
  for (const [lang, localizedSlug] of Object.entries(slugTranslations)) {
    if (lang === 'en') {
      hreflangAlternates.push({ lang: 'en', href: `${siteUrl}/blog/${localizedSlug}` });
    } else {
      hreflangAlternates.push({ lang: lang.toLowerCase(), href: `${siteUrl}/${lang.toLowerCase()}/blog/${localizedSlug}` });
    }
  }
} else {
  // Fallback: at least add the English version
  hreflangAlternates.push({ lang: 'en', href: `${siteUrl}/blog/${enSlug}` });
}
---

<BlogLayout
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  author={post.data.author}
  image={post.data.image}
  imageAlt={post.data.imageAlt}
  readingTime={post.data.readingTime}
  tags={post.data.tags}
  shortAnswer={post.data.shortAnswer}
  about={post.data.about}
  mentions={post.data.mentions}
  sources={post.data.sources}
  hreflangAlternates={hreflangAlternates}
  faqs={faqs}
>
  <Content />
</BlogLayout>
