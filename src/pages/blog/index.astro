---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getUITranslation } from '../../utils/uiTranslations';
import { getCollection } from 'astro:content';
import { getSiteUrl } from '../../utils/siteConfig';

const siteUrl = Astro.site ? Astro.site.origin : getSiteUrl();
const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(post => post.id.startsWith('en/'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const localizedLangs = new Set<string>();
allPosts.forEach(post => {
  if (!post.id.startsWith('en/')) {
    localizedLangs.add(post.id.split('/')[0]);
  }
});

const hreflangAlternates: Array<{ lang: string; href: string }> = [
  { lang: 'en', href: `${siteUrl}/blog` },
  ...Array.from(localizedLangs).sort().map(l => ({
    lang: l.toLowerCase() === 'ar-ma' ? 'ar-MA' : l.toLowerCase(),
    href: `${siteUrl}/${l.toLowerCase()}/blog`,
  })),
];
---

<BaseLayout
  title={getUITranslation('en', 'blogMetaTitle')}
  description={getUITranslation('en', 'blogMetaDescription')}
  schemaType="blogIndex"
  lang="en"
  showLanguageSwitcher={true}
  hreflangAlternates={hreflangAlternates}
>
  <div class="blog-index">
    <div class="container">
      <!-- Header -->
      <div class="blog-index__header">
        <nav class="blog-index__breadcrumb" aria-label="Breadcrumb">
          <a href="/">{getUITranslation('en', 'home')}</a>
          <span aria-hidden="true">→</span>
          <span>{getUITranslation('en', 'blog')}</span>
        </nav>
        <span class="label">{getUITranslation('en', 'healthResources')}</span>
        <h1 class="heading-section" style="text-align: left;">{getUITranslation('en', 'healthGuidesTitle1')}<br/><span class="text-gradient">{getUITranslation('en', 'healthGuidesTitle2')}</span></h1>
        <p class="subtitle">{getUITranslation('en', 'healthGuidesSubtitle')}</p>

        <div class="blog-search" role="search">
          <input
            type="search"
            id="blog-search-input"
            class="blog-search__input"
            placeholder={getUITranslation('en', 'searchPlaceholder')}
            aria-label={getUITranslation('en', 'searchPlaceholder')}
          />
        </div>
      </div>

      <p id="blog-search-empty" class="blog-search__empty" hidden>{getUITranslation('en', 'noResults')}</p>

      <!-- Posts Grid -->
      <div class="grid-2" id="blog-posts-grid">
        {posts.map((post) => (
          <a
            href={`/blog/${post.id.replace('en/', '')}`}
            class="blog-card"
            id={`blog-card-${post.id.replace('en/', '')}`}
            data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')}`.toLowerCase()}
          >
            <div class="blog-card__image">
              {post.data.image ? (
                <img src={post.data.image} alt={post.data.imageAlt || post.data.title} loading="lazy" />
              ) : (
                <div class="blog-card__image-placeholder" style={`background: linear-gradient(135deg, var(--color-accent-glow), rgba(14, 165, 233, 0.15));`}>
                  <span class="blog-card__image-icon" style="color: var(--color-accent); display: flex; align-items: center; justify-content: center;" aria-hidden="true">
                    {post.data.tags.includes('Blood Tests') ? (
                      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
                    ) : (
                      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z"/><path d="m8.5 8.5 7 7"/></svg>
                    )}
                  </span>
                </div>
              )}
            </div>
            <div class="blog-card__body">
              <span class="blog-card__tag">{post.data.tags[0]}</span>
              <h2 class="blog-card__title">{post.data.title}</h2>
              <p class="blog-card__excerpt">{post.data.description}</p>
              <div class="blog-card__meta">
                <span>{post.data.author}</span>
                <span>•</span>
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </time>
                <span>•</span>
                <span>{post.data.readingTime}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var input = document.getElementById('blog-search-input');
    var grid = document.getElementById('blog-posts-grid');
    var empty = document.getElementById('blog-search-empty');
    if (!input || !grid) return;

    var cards = Array.prototype.slice.call(grid.querySelectorAll('.blog-card'));
    function filterPosts(query) {
      var q = (query || '').trim().toLowerCase();
      var visibleCount = 0;
      cards.forEach(function (card) {
        var haystack = card.getAttribute('data-search') || '';
        var show = !q || haystack.indexOf(q) !== -1;
        card.style.display = show ? '' : 'none';
        if (show) visibleCount++;
      });
      if (empty) empty.hidden = visibleCount > 0;
    }

    var params = new URLSearchParams(window.location.search);
    var initialQ = params.get('q') || '';
    if (initialQ) {
      input.value = initialQ;
      filterPosts(initialQ);
    }

    input.addEventListener('input', function () {
      filterPosts(input.value);
    });
  })();
</script>

<style>
  .blog-index {
    padding-top: calc(var(--header-height) + var(--space-12));
    padding-bottom: var(--space-24);
  }

  .blog-index__header {
    margin-bottom: var(--space-12);
  }

  .blog-index__breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
  }

  .blog-index__breadcrumb a {
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
  }

  .blog-index__breadcrumb a:hover {
    color: var(--color-accent);
  }

  .blog-search {
    margin-top: var(--space-6);
    max-width: 480px;
  }

  .blog-search__input {
    width: 100%;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-bg-card);
    color: var(--color-text-primary);
    font-size: var(--text-base);
    outline: none;
    transition: border-color var(--transition-fast);
  }

  .blog-search__input:focus {
    border-color: var(--color-accent);
  }

  .blog-search__empty {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-8);
    font-size: var(--text-base);
  }

  .blog-card__image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .blog-card__image-emoji {
    font-size: 3rem;
  }
</style>
