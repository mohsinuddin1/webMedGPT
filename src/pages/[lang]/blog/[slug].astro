---
import BlogLayout from '../../../layouts/BlogLayout.astro';
import { getCollection, render } from 'astro:content';
import { slugMap, getBaseSlug } from '../../../utils/slugMap';
import { extractFaqsFromMarkdown } from '../../../utils/faqExtractor';

const siteUrl = 'https://medgptai.droploop.in';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  
  // Filter out English posts since they are handled by the main route
  const localizedPosts = posts.filter(post => !post.id.startsWith('en/'));
  
  return localizedPosts.map((post) => {
    // ID format is lang/slug
    const [lang, ...slugParts] = post.id.split('/');
    const slug = slugParts.join('/');
    
    return {
      params: { lang, slug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { lang } = Astro.params;
const { Content } = await render(post);
const faqs = extractFaqsFromMarkdown(post.body);

// Get the localized slug from the post ID
const localizedSlug = post.id.split('/').slice(1).join('/');

// Find the base (English) slug for this post
const baseSlug = getBaseSlug(localizedSlug);

// Build hreflang alternates from the slug map
const hreflangAlternates: Array<{ lang: string; href: string }> = [];
if (baseSlug && slugMap[baseSlug]) {
  for (const [altLang, altSlug] of Object.entries(slugMap[baseSlug])) {
    if (altLang === 'en') {
      hreflangAlternates.push({ lang: 'en', href: `${siteUrl}/blog/${altSlug}` });
    } else {
      hreflangAlternates.push({ lang: altLang.toLowerCase(), href: `${siteUrl}/${altLang.toLowerCase()}/blog/${altSlug}` });
    }
  }
} else {
  // Fallback
  hreflangAlternates.push({ lang: lang || 'en', href: `${siteUrl}/${lang}/blog/${localizedSlug}` });
}
---

<BlogLayout
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  author={post.data.author}
  image={post.data.image}
  imageAlt={post.data.imageAlt}
  readingTime={post.data.readingTime}
  tags={post.data.tags}
  shortAnswer={post.data.shortAnswer}
  about={post.data.about}
  mentions={post.data.mentions}
  sources={post.data.sources}
  lang={lang}
  hreflangAlternates={hreflangAlternates}
  faqs={faqs}
>
  <Content />
</BlogLayout>
