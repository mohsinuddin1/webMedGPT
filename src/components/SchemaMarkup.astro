---
export interface Props {
  type: 'homepage' | 'article' | 'legal';
  title?: string;
  description?: string;
  publishedDate?: string;
  modifiedDate?: string;
  author?: string;
  image?: string;
  faqs?: Array<{ question: string; answer: string }>;
  about?: string[];
  mentions?: string[];
  sources?: Array<{ name: string; url: string; description?: string }>;
}

const { type, title, description, publishedDate, modifiedDate, author, image, faqs, about = [], mentions = [], sources = [] } = Astro.props;
const siteUrl = 'https://medgptai.droploop.in';
const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();

// Organization schema (always present)
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'PureScan AI',
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'contact@droploop.in',
    contactType: 'customer support',
  },
};

// SoftwareApplication schema
const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'MedGPT — AI Health Assistant',
  operatingSystem: 'Android, Web',
  applicationCategory: 'HealthApplication',
  applicationSubCategory: 'MedicalInformatics',
  description: 'AI-powered educational health companion. Analyze medical reports, blood tests, understand medications, explore symptoms, and prepare for doctor visits.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  installUrl: 'https://play.google.com/store/apps/details?id=com.medgptai.app',
  author: {
    '@type': 'Organization',
    name: 'PureScan AI',
    url: siteUrl,
  },
  featureList: [
    'Complete Blood Count (CBC) breakdown',
    'Liver & kidney function test interpretation',
    'Radiology report simplifier (X-ray, CT, MRI, Ultrasound)',
    'Medication indications & side effect verification',
    'Doctor appointment preparation checklist',
    'Multilingual medical translation in 25 languages',
  ],
};

// WebSite schema (homepage only) with SearchAction for AEO/Sitelinks
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'MedGPT',
  url: siteUrl,
  publisher: {
    '@type': 'Organization',
    name: 'PureScan AI',
  },
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${siteUrl}/blog?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};

// Helper to parse 'Type: Name' strings (e.g. 'MedicalCondition: Keratosis Pilaris')
const parseEntity = (item: string) => {
  const parts = item.split(':');
  if (parts.length === 2) {
    return { '@type': parts[0].trim(), name: parts[1].trim() };
  }
  return { '@type': 'Thing', name: item };
};

// Article schema
const articleSchema = publishedDate ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  datePublished: publishedDate,
  dateModified: modifiedDate || publishedDate,
  author: {
    '@type': 'Organization',
    name: author || 'MedGPT Team',
    url: siteUrl,
  },
  publisher: {
    '@type': 'Organization',
    name: 'PureScan AI',
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/favicon.svg`,
    },
  },
  isAccessibleForFree: true,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': pageUrl,
  },
  ...(about.length > 0 && { about: about.map(parseEntity) }),
  ...(mentions.length > 0 && { mentions: mentions.map(parseEntity) }),
  image: image ? (image.startsWith('http') ? image : `${siteUrl}${image}`) : `${siteUrl}/og-image.png`,
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.prose h1', '.prose h2', '.blog-post__short-answer', '.prose p:first-of-type'],
  },
  ...(sources.length > 0 ? {
    reviewedBy: {
      '@type': 'Organization',
      name: sources[0].name,
      url: sources[0].url,
    },
    citation: sources.map(s => ({
      '@type': 'CreativeWork',
      name: s.name,
      url: s.url,
    })),
    isBasedOn: sources.map(s => s.url),
  } : {}),
} : null;

// MedicalWebPage (for health articles)
const medicalWebPageSchema = type === 'article' ? {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  name: title,
  url: pageUrl,
  description: description,
  lastReviewed: modifiedDate || publishedDate,
  author: {
    '@type': 'Organization',
    name: author || 'MedGPT Team',
    url: siteUrl,
  },
  medicalAudience: {
    '@type': 'PatientAudience',
  },
  ...(sources.length > 0 ? {
    citation: sources.map(s => s.url),
  } : {}),
} : null;

// FAQ schema
const faqSchema = faqs && faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
} : null;

// BreadcrumbList schema matching visible hierarchy (Home -> Blog -> Article)
const breadcrumbListItems = [
  {
    '@type': 'ListItem',
    position: 1,
    name: 'Home',
    item: siteUrl,
  },
];

if (type === 'article') {
  breadcrumbListItems.push(
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Blog',
      item: `${siteUrl}/blog`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: title || 'Article',
      item: pageUrl,
    }
  );
} else if (type !== 'homepage') {
  breadcrumbListItems.push({
    '@type': 'ListItem',
    position: 2,
    name: title || 'Page',
    item: pageUrl,
  });
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbListItems,
};

const schemas = [
  organizationSchema,
  breadcrumbSchema,
  ...(type === 'homepage' ? [appSchema, websiteSchema] : []),
  ...(articleSchema ? [articleSchema] : []),
  ...(medicalWebPageSchema ? [medicalWebPageSchema] : []),
  ...(faqSchema ? [faqSchema] : []),
];
---

{schemas.map(schema => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
