---
export interface Props {
  type: 'homepage' | 'article' | 'legal' | 'blogIndex' | 'techDoc';
  title?: string;
  description?: string;
  publishedDate?: string;
  modifiedDate?: string;
  author?: string;
  image?: string;
  faqs?: Array<{ question: string; answer: string }>;
  about?: string[];
  mentions?: string[];
  sources?: Array<{ name: string; url: string; description?: string }>;
  lang?: string;
}

import { getSiteUrl, SITE_EMAIL } from '../utils/siteConfig';
import { getUITranslation } from '../utils/uiTranslations';

const {
  type,
  title,
  description,
  publishedDate,
  modifiedDate,
  author,
  image,
  faqs,
  about = [],
  mentions = [],
  sources = [],
  lang = 'en',
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.origin : getSiteUrl();
const rawPath = Astro.url.pathname;
const cleanPath = rawPath === '/' ? '/' : rawPath.replace(/\/+$/, '');
const pageUrl = new URL(cleanPath, siteUrl).toString();
const langLower = (lang || 'en').toLowerCase();
const blogIndexUrl = langLower === 'en' ? `${siteUrl}/blog` : `${siteUrl}/${langLower}/blog`;

// Organization schema (always present)
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'PureScan AI',
  url: siteUrl,
  logo: `${siteUrl}/appLogo.png`,
  contactPoint: {
    '@type': 'ContactPoint',
    email: SITE_EMAIL,
    contactType: 'customer support',
  },
};

// SoftwareApplication schema
const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'MedGPT — AI Health Assistant',
  operatingSystem: 'Android, iOS, Web',
  applicationCategory: 'HealthApplication',
  applicationSubCategory: 'MedicalInformatics',
  description: 'AI-powered educational health companion. Analyze medical reports, blood tests, understand medications, explore symptoms, and prepare for doctor visits.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  installUrl: 'https://play.google.com/store/apps/details?id=com.medgptai.app',
  sameAs: [
    'https://play.google.com/store/apps/details?id=com.medgptai.app',
    'https://apps.apple.com/us/app/health-assistant-ai-wellness/id6837951020',
  ],
  author: {
    '@type': 'Organization',
    name: 'PureScan AI',
    url: siteUrl,
  },
  featureList: [
    'Complete Blood Count (CBC) breakdown',
    'Liver & kidney function test interpretation',
    'Radiology report simplifier (X-ray, CT, MRI, Ultrasound)',
    'Medication indications & side effect verification',
    'Doctor appointment preparation checklist',
    'Multilingual medical translation in 24 languages',
  ],
};

// WebSite schema (homepage only) with SearchAction for AEO/Sitelinks
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'MedGPT',
  url: siteUrl,
  inLanguage: 'en',
  publisher: {
    '@type': 'Organization',
    name: 'PureScan AI',
  },
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${siteUrl}/blog?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};

// Map Schema.org Product subclasses (like Drug or DietarySupplement) and non-standard types
// to MedicalEntity/Substance so Google Search Console does not validate informational
// entity mentions as commercial Product snippets requiring offers, review, or aggregateRating.
const PRODUCT_SUBCLASS_MAP: Record<string, string> = {
  Drug: 'Substance',
  DietarySupplement: 'Substance',
  Product: 'Thing',
  IndividualProduct: 'Thing',
  ProductModel: 'Thing',
  ProductGroup: 'Thing',
  SomeProducts: 'Thing',
  HealthTopic: 'MedicalEntity',
};

// Helper to parse 'Type: Name' strings (e.g. 'MedicalCondition: Keratosis Pilaris')
const parseEntity = (item: string) => {
  const parts = item.split(':');
  if (parts.length >= 2) {
    const rawType = parts[0].trim();
    const name = parts.slice(1).join(':').trim();
    const safeType = PRODUCT_SUBCLASS_MAP[rawType] || rawType;
    return { '@type': safeType, name };
  }
  return { '@type': 'Thing', name: item };
};

// Article schema
const articleSchema = type === 'article' && publishedDate ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  inLanguage: lang,
  datePublished: publishedDate,
  dateModified: modifiedDate || publishedDate,
  author: {
    '@type': 'Organization',
    name: author || 'MedGPT Team',
    url: siteUrl,
  },
  publisher: {
    '@type': 'Organization',
    name: 'PureScan AI',
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/appLogo.png`,
    },
  },
  isAccessibleForFree: true,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': pageUrl,
  },
  ...(about.length > 0 && { about: about.map(parseEntity) }),
  ...(mentions.length > 0 && { mentions: mentions.map(parseEntity) }),
  image: image ? (image.startsWith('http') ? image : `${siteUrl}${image}`) : `${siteUrl}/og-image.png`,
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.prose h1', '.prose h2', '.blog-post__short-answer', '.prose p:first-of-type'],
  },
  ...(sources.length > 0 ? {
    citation: sources.map(s => ({
      '@type': 'CreativeWork',
      name: s.name,
      url: s.url,
    })),
    isBasedOn: sources.map(s => s.url),
  } : {}),
} : null;

// MedicalWebPage (for health articles only)
const medicalWebPageSchema = type === 'article' ? {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  name: title,
  url: pageUrl,
  description: description,
  inLanguage: lang,
  lastReviewed: modifiedDate || publishedDate,
  author: {
    '@type': 'Organization',
    name: author || 'MedGPT Team',
    url: siteUrl,
  },
  medicalAudience: {
    '@type': 'PatientAudience',
  },
  ...(sources.length > 0 ? {
    citation: sources.map(s => s.url),
  } : {}),
} : null;

// CollectionPage schema (for blog indexes)
const blogIndexSchema = type === 'blogIndex' ? {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  url: pageUrl,
  description: description,
  inLanguage: lang,
  isPartOf: {
    '@type': 'WebSite',
    url: siteUrl,
  },
} : null;

// TechArticle schema (for developer/API docs)
const techDocSchema = type === 'techDoc' ? {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  description: description,
  url: pageUrl,
  inLanguage: lang,
  author: {
    '@type': 'Organization',
    name: 'PureScan AI',
    url: siteUrl,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': pageUrl,
  },
} : null;

// FAQ schema
const faqSchema = faqs && faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
} : null;

// BreadcrumbList schema matching visible hierarchy
const breadcrumbListItems = [
  {
    '@type': 'ListItem',
    position: 1,
    name: getUITranslation(lang, 'home'),
    item: `${siteUrl}/`,
  },
];

if (type === 'article') {
  breadcrumbListItems.push(
    {
      '@type': 'ListItem',
      position: 2,
      name: getUITranslation(lang, 'blog'),
      item: blogIndexUrl,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: title || 'Article',
      item: pageUrl,
    }
  );
} else if (type === 'blogIndex') {
  breadcrumbListItems.push({
    '@type': 'ListItem',
    position: 2,
    name: getUITranslation(lang, 'blog'),
    item: pageUrl,
  });
} else if (type !== 'homepage') {
  breadcrumbListItems.push({
    '@type': 'ListItem',
    position: 2,
    name: title || 'Page',
    item: pageUrl,
  });
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbListItems,
};

const schemas = [
  organizationSchema,
  breadcrumbSchema,
  ...(type === 'homepage' ? [appSchema, websiteSchema] : []),
  ...(articleSchema ? [articleSchema] : []),
  ...(medicalWebPageSchema ? [medicalWebPageSchema] : []),
  ...(blogIndexSchema ? [blogIndexSchema] : []),
  ...(techDocSchema ? [techDocSchema] : []),
  ...(faqSchema ? [faqSchema] : []),
];
---

{schemas.map(schema => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
