---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  noindex?: boolean;
  lang?: string;
  hreflangAlternates?: Array<{ lang: string; href: string }>;
}

const {
  title,
  description,
  canonical,
  ogImage = '/og-image.png',
  ogType = 'website',
  publishedTime,
  modifiedTime,
  author,
  noindex = false,
  lang = 'en',
  hreflangAlternates = [],
} = Astro.props;

const siteName = 'MedGPT';
const siteUrl = 'https://medgptai.droploop.in';
const fullTitle = title.includes('MedGPT') ? title : `${title} — ${siteName}`;

// Clean pathname: remove trailing slash for consistency (unless it's root)
const pathname = Astro.url.pathname;
const cleanPathname = pathname === '/' ? '/' : pathname.replace(/\/$/, '');
const canonicalUrl = canonical || new URL(cleanPathname, siteUrl).toString();

const ogImageUrl = ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteUrl).toString();

// Map language codes to og:locale format
const langToOgLocale: Record<string, string> = {
  'en': 'en_US', 'fr': 'fr_FR', 'es': 'es_ES', 'de': 'de_DE',
  'it': 'it_IT', 'pt': 'pt_PT', 'nl': 'nl_NL', 'sv': 'sv_SE',
  'da': 'da_DK', 'no': 'no_NO', 'nb': 'nb_NO', 'pl': 'pl_PL',
  'cs': 'cs_CZ', 'ro': 'ro_RO', 'lt': 'lt_LT', 'lv': 'lv_LV',
  'bg': 'bg_BG', 'el': 'el_GR', 'tr': 'tr_TR', 'ru': 'ru_RU',
  'ar': 'ar_SA', 'ar-MA': 'ar_MA', 'ja': 'ja_JP', 'ko': 'ko_KR',
  'zh': 'zh_CN',
};
const currentOgLocale = langToOgLocale[lang] || 'en_US';
---

<!-- Primary Meta -->
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
<link rel="canonical" href={canonicalUrl} />

<!-- Hreflang Tags for International SEO -->
{hreflangAlternates.map(alt => (
  <link rel="alternate" hreflang={alt.lang} href={alt.href} />
))}
{hreflangAlternates.length > 0 && (
  <link rel="alternate" hreflang="x-default" href={hreflangAlternates.find(a => a.lang === 'en')?.href || canonicalUrl} />
)}

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content={siteName} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={currentOgLocale} />
{hreflangAlternates.filter(a => a.lang !== lang).map(alt => (
  <meta property="og:locale:alternate" content={langToOgLocale[alt.lang] || alt.lang} />
))}

<!-- Twitter/X Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- Article-specific -->
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{author && <meta property="article:author" content={author} />}

<!-- Misc -->
<meta name="theme-color" content="#00d4aa" />
<meta name="application-name" content={siteName} />
<meta name="google-play-app" content="app-id=com.medgptai.app" />
<meta name="google-site-verification" content="viybWkN34LbYpJIo4S6U45yJ_dyolZ6suvyIlKZgz9U" />
<link rel="icon" type="image/png" href="/appLogo.png" />
<link rel="manifest" href="/manifest.json" />

